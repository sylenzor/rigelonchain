{
  "name": "@rigel-protocol/solana-mcp",
  "version": "1.2.0",
  "description": "Open-source MCP server that gives AI agents read-only eyes on Solana: wallet balances, pump.fun token data, and rug-risk checks.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "rigel-solana-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "solana",
    "pump.fun",
    "claude",
    "ai-agent",
    "blockchain"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sylenzor/rigelonchain.git",
    "directory": "mcp"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@solana/web3.js": "^1.95.0",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
